{
  "name": "@react-three/lightmap",
  "version": "0.0.8",
  "description": "In-browser lightmap/AO baker for react-three-fiber and ThreeJS",
  "keywords": [
    "react",
    "threejs",
    "react-three-fiber",
    "r3f",
    "lightmap",
    "lightmap-baker",
    "ao",
    "ambient occlusion",
    "ao-baker"
  ],
  "main": "dist/entry.js",
  "module": "dist/entry.mjs",
  "typings": "dist/entry.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=10"
  },
  "dependencies": {
    "potpack": "^1.0.1"
  },
  "scripts": {
    "start": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "npm run build",
    "prepare": "husky",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook --testTimeout 90000"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmndrs/react-three-lightmap.git"
  },
  "author": "Nick Matantsev <nick.matantsev@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pmndrs/react-three-lightmap/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-three/drei": "^9.0.0",
    "@react-three/fiber": "^8.0.0",
    "@size-limit/preset-small-lib": "^12",
    "@storybook/react-vite": "^10",
    "@storybook/test-runner": "^0.24.4",
    "@types/jest-image-snapshot": "^6.4.1",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/three": "^0.151.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9",
    "jest-image-snapshot": "^6.5.2",
    "playwright": "^1.61.1",
    "prettier": "^2.5.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-is": "^18.0.0",
    "size-limit": "^12",
    "storybook": "^10",
    "three": "^0.151.3",
    "tslib": "^2.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=8.0.0",
    "react": ">=16",
    "three": ">=0.151.0"
  },
  "size-limit": [
    {
      "path": "dist/entry.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/entry.mjs",
      "limit": "10 KB"
    }
  ]
}
